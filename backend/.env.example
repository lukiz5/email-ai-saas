# Database
DATABASE_URL=postgresql://user:password@localhost:5432/email_ai_saas

# AI - Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Authentication - Get from https://clerk.com/
CLERK_PEM_PUBLIC_KEY=your_clerk_pem_public_key_here

# Stripe - Get from https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PRICE_ID_PRO=price_your_stripe_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_SUCCESS_URL=http://localhost:5173/success
STRIPE_CANCEL_URL=http://localhost:5173/pricing
STRIPE_RETURN_URL=http://localhost:5173/settings

# Google OAuth - Get from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback

# Microsoft OAuth - Get from https://portal.azure.com/
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/outlook/callback

# Security - Generate a secure random 32-byte key
ENCRYPTION_KEY=your_32_byte_base64_encoded_encryption_key

# Frontend URL
FRONTEND_URL=http://localhost:5173
